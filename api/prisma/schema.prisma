generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject    String @unique
  yearFrom   Int
  yearTo     Int
  pricePence Int
}
