# Local defaults. docker compose works without a .env file; copy this to .env to override.

# Database (used by the db, migrate and api services)
POSTGRES_USER=mes
POSTGRES_PASSWORD=mes
POSTGRES_DB=mes

# Port published by the web service
WEB_PORT=8080

# Session signing secret, at least 32 characters (e.g. `openssl rand -hex 32`). Optional:
# when unset the API generates a random one at start, and a restart signs everyone out.
# JWT_SECRET=
# Set to true when the app is served over https.
# COOKIE_SECURE=false

# Running the API and the Prisma CLI on the host instead of in compose: both read the
# repository-root .env. Start a throwaway database with `npm run db:dev -w api`.
DATABASE_URL=postgresql://mes:mes@localhost:54329/mes
PORT=3100
